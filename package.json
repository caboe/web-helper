{
  "name": "ai-page-actions",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome-Extension (MV3): LLM-Endpunkte & Systemprompts verwalten, Seiteninhalte senden, Tool-Calling auf der Seite.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test:llm": "node scripts/test-llm.mjs",
    "package": "npm run build && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.9",
    "svelte-check": "~4.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
